{
  "name": "template-workflow",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Standalone Dario Claude Code template capture, scrub, drift detection and automation",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "template-workflow": "bin/template-workflow.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-template.mjs",
    "test": "node scripts/test.mjs",
    "capture": "node bin/template-workflow.mjs capture",
    "check": "node bin/template-workflow.mjs check",
    "status": "node bin/template-workflow.mjs status",
    "export": "node bin/template-workflow.mjs export",
    "verify": "node bin/template-workflow.mjs verify",
    "label-sync": "node bin/template-workflow.mjs label-sync",
